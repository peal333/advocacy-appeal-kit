{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/advocacy-appeal-kit/campaign.schema.json",
  "title": "Advocacy Appeal Kit campaign version 1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "integer"
    },
    "id": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
    },
    "title": {
      "type": "string",
      "maxLength": 300
    },
    "summary": {
      "type": "string",
      "maxLength": 2000
    },
    "language": {
      "type": "string",
      "maxLength": 35
    },
    "siteUrl": {
      "type": "string",
      "maxLength": 2000
    },
    "updated": {
      "type": "string",
      "maxLength": 10
    },
    "introduction": {
      "type": "string",
      "maxLength": 30000
    },
    "action": {
      "type": "string",
      "maxLength": 30000
    },
    "petitionUrl": {
      "type": "string",
      "maxLength": 2000
    },
    "theme": {
      "type": "object",
      "properties": {
        "accent": {
          "type": "string",
          "maxLength": 7
        },
        "background": {
          "type": "string",
          "maxLength": 7
        }
      },
      "required": [
        "accent",
        "background"
      ],
      "additionalProperties": false
    },
    "poster": {
      "type": "string",
      "maxLength": 200
    },
    "posterAlt": {
      "type": "string",
      "maxLength": 2000,
      "description": "Optional poster description. Missing or blank alternative text produces an accessibility warning when a poster is present; it does not block preview or export."
    },
    "socialImage": {
      "type": "string",
      "maxLength": 200
    },
    "sections": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string",
            "maxLength": 300
          },
          "body": {
            "type": "string",
            "maxLength": 30000
          }
        },
        "required": [
          "heading",
          "body"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80
          },
          "title": {
            "type": "string",
            "maxLength": 1000
          },
          "url": {
            "type": "string",
            "maxLength": 2000
          },
          "publisher": {
            "type": "string",
            "maxLength": 1000
          },
          "checked": {
            "type": "string",
            "maxLength": 10
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "publisher",
          "checked"
        ],
        "additionalProperties": false
      }
    },
    "timeline": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "maxLength": 200
          },
          "text": {
            "type": "string",
            "maxLength": 30000
          },
          "sourceId": {
            "type": "string",
            "maxLength": 80
          }
        },
        "required": [
          "date",
          "text",
          "sourceId"
        ],
        "additionalProperties": false
      }
    },
    "event": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "maxLength": 300
            },
            "dateTime": {
              "type": "string",
              "maxLength": 50
            },
            "sourceId": {
              "type": "string",
              "maxLength": 80
            },
            "afterText": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": [
            "label",
            "dateTime",
            "sourceId",
            "afterText"
          ],
          "additionalProperties": false
        }
      ]
    },
    "socialLinks": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 300
          },
          "url": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "label",
          "url"
        ],
        "additionalProperties": false
      }
    },
    "contacts": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80
          },
          "name": {
            "type": "string",
            "maxLength": 300
          },
          "role": {
            "type": "string",
            "maxLength": 500
          },
          "country": {
            "type": "string",
            "maxLength": 200,
            "description": "Optional country label displayed below the contact role. Omit or leave blank when not needed."
          },
          "group": {
            "type": "string",
            "maxLength": 200
          },
          "email": {
            "type": "string",
            "maxLength": 320
          },
          "sourceUrl": {
            "type": "string",
            "maxLength": 2000,
            "description": "Optional public source URL. Omit or leave blank if not recorded; a provided URL must use HTTP or HTTPS."
          },
          "verified": {
            "type": "string",
            "maxLength": 10,
            "description": "Optional actual contact-review date in YYYY-MM-DD format. Omit or leave blank if not recorded."
          },
          "priority": {
            "type": "string",
            "maxLength": 100
          },
          "subject": {
            "type": "string",
            "maxLength": 2000
          },
          "body": {
            "type": "string",
            "maxLength": 30000
          }
        },
        "required": [
          "id",
          "name",
          "role",
          "group",
          "email",
          "priority"
        ],
        "additionalProperties": false
      }
    },
    "messages": {
      "type": "object",
      "properties": {
        "subject": {
          "type": "string",
          "maxLength": 2000
        },
        "body": {
          "type": "string",
          "maxLength": 30000
        }
      },
      "required": [
        "subject",
        "body"
      ],
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 200
          },
          "creator": {
            "type": "string",
            "maxLength": 1000
          },
          "sourceUrl": {
            "type": "string",
            "maxLength": 2000
          },
          "permission": {
            "type": "string",
            "maxLength": 3000
          }
        },
        "required": [
          "path",
          "creator",
          "sourceUrl",
          "permission"
        ],
        "additionalProperties": false
      }
    },
    "groups": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "description": "Optional persistent contact-group names, including groups with no contacts. Older version-1 campaigns may omit this list.",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^(?!\\s)(?!.*[\\u0000-\\u001f\\u007f]).*\\S$"
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headerTitle": {
          "type": "string",
          "maxLength": 300
        },
        "sharing": {
          "type": "boolean"
        },
        "shareText": {
          "type": "string",
          "maxLength": 2000
        },
        "timer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "label": {
              "type": "string",
              "maxLength": 300
            },
            "dateTime": {
              "type": "string",
              "maxLength": 50
            },
            "dateLabel": {
              "type": "string",
              "maxLength": 300
            },
            "afterText": {
              "type": "string",
              "maxLength": 2000
            }
          }
        },
        "background": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "title": {
              "type": "string",
              "maxLength": 300
            },
            "body": {
              "type": "string",
              "maxLength": 30000
            }
          }
        },
        "timeline": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "title": {
              "type": "string",
              "maxLength": 300
            }
          }
        },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "title": {
              "type": "string",
              "maxLength": 300
            }
          }
        },
        "efforts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "title": {
              "type": "string",
              "maxLength": 300
            },
            "items": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "title": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "url": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 3000
                  }
                },
                "required": [
                  "title",
                  "url",
                  "description"
                ]
              }
            }
          }
        },
        "footer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "followXUrl": {
              "type": "string",
              "maxLength": 2000
            },
            "middleText": {
              "type": "string",
              "maxLength": 2000
            },
            "showUpdated": {
              "type": "boolean"
            }
          }
        }
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "summary",
    "language",
    "siteUrl",
    "updated",
    "introduction",
    "action",
    "petitionUrl",
    "theme",
    "poster",
    "socialImage",
    "sections",
    "sources",
    "timeline",
    "event",
    "socialLinks",
    "contacts",
    "messages",
    "assets"
  ],
  "additionalProperties": false
}
